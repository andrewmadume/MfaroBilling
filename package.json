{
  "name": "mfaro-billing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/customer-portal",
    "apps/admin-dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mfaro/customer-portal",
    "dev:admin": "npm run dev -w @mfaro/admin-dashboard",
    "build": "npm run build -w @mfaro/customer-portal && npm run build -w @mfaro/admin-dashboard",
    "typecheck": "tsc --noEmit",
    "test": "node --test packages/billing-sdk/test/*.test.mjs",
    "build:production": "node tools/build-production.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "@vitejs/plugin-react": "^5.1.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.4.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.2.0",
    "zod": "^4.1.0"
  }
}
